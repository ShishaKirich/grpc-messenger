# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

APP_NAME=Лес из Шишек
# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_PATH=data/app.db
# Поставьте true, когда сайт работает по HTTPS (включает флаг Secure у cookie и HSTS)
COOKIE_SECURE=false

# console — коды печатаются в терминал (удобно для разработки)
# smtp    — коды уходят на почту
MAIL_BACKEND=console

# Gmail: нужна включённая двухэтапная проверка и пароль приложения
# (Аккаунт Google → Безопасность → Пароли приложений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=your.address@gmail.com

# Проверка паролей по базе утечек Have I Been Pwned (наружу уходят только 5 символов хеша)
HIBP_ENABLED=true
PASSWORD_MIN_LENGTH=10

# Мессенджер (gRPC). Сертификаты создаёт scripts/make_dev_cert.py, папка certs/ в git не попадает.
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
WEB_URL=http://localhost:8000
